    <!-- Robot -->
    <include>
      <uri>model://lane_bot</uri>
      <pose>-0.02 -0.22 0.05 0 0 0</pose>
    </include>

    <!-- Overhead camera -->
    <!-- Overhead camera -->
    <model name="overhead_camera_model">
      <static>true</static>
      <pose>-0.05 -0.4 2.0 0 1.5708 0</pose>

      <link name="overhead_camera_link">
        <sensor name="overhead_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>/image_raw</topic>

          <camera>
            <horizontal_fov>0.7175</horizontal_fov>
            <image>
              <width>960</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

